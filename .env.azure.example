# Copy to .env.azure and fill in values from your Linea-deploy GitHub secrets.

# Public FQDN of the externally-exposed linea-server Container App.
# Get it after redeploying infra with serverExternalIngress=true:
#   az containerapp show -g Linea-rg -n linea-server --query properties.configuration.ingress.fqdn -o tsv
LINEA_SERVER_URL=https://linea-server.<env-domain>.centralindia.azurecontainerapps.io

# Comma-separated list of providers to expose locally. "microsoft"
# only by default; set to "microsoft,google" to also enable Google.
LINEA_OIDC_PROVIDERS=microsoft

# Microsoft / Entra (always required).
LINEA_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
LINEA_OIDC_MICROSOFT_CLIENT_ID=<LINEA_WEB_CLIENT_ID>
LINEA_OIDC_MICROSOFT_CLIENT_SECRET=<LINEA_WEB_CLIENT_SECRET>

# Google (only required when LINEA_OIDC_PROVIDERS includes "google").
LINEA_OIDC_GOOGLE_CLIENT_ID=
LINEA_OIDC_GOOGLE_CLIENT_SECRET=
