{
  "realm": "linea",
  "enabled": true,
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "clients": [
    {
      "clientId": "linea-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "linea-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/auth/callback"
      ],
      "webOrigins": ["http://localhost:8090"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8090/*"
      }
    },
    {
      "clientId": "linea-cli",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost/*"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Example",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "alice", "temporary": false}
      ],
      "realmRoles": ["default-roles-linea"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Example",
      "emailVerified": true,
      "credentials": [
        {"type": "password", "value": "bob", "temporary": false}
      ]
    }
  ]
}
